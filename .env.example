# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# MongoDB Configuration (for bot hosting - REQUIRED for persistent storage)
# Get your MongoDB connection string from MongoDB Atlas or your MongoDB provider
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/monster_bot?retryWrites=true&w=majority

# Alternative MongoDB environment variable name (also supported)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/monster_bot?retryWrites=true&w=majority

# MongoDB Database Name (optional, defaults to 'monster_bot')
# MONGODB_DB_NAME=monster_bot

# Optional: Data directory for SQLite fallback (only used if MongoDB is not configured)
# DATA_DIR=./data

# Bot Configuration
# NODE_ENV=production

# Website Discord OAuth2 (create an application in the Discord Developer Portal)
# DISCORD_CLIENT_ID=your_discord_application_client_id
# DISCORD_CLIENT_SECRET=your_discord_application_client_secret
# DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
# WEB_PORT=3000
# Development-only account fallback; remove this when OAuth is configured.
# WEB_USER_ID=your_discord_user_id